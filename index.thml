<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Play Minecraft</title>
  <style>
    body { margin:0; background:#111; color:#eee; font-family:sans-serif;
           display:flex; flex-direction:column; align-items:center; padding:16px; }
    #game-wrap { position:relative; width:100%; max-width:1100px; aspect-ratio:16/9; background:#000; }
    #game { position:absolute; inset:0; width:100%; height:100%; border:0; }
    button { margin-top:12px; padding:10px 20px; font-size:16px; cursor:pointer; }
  </style>
</head>
<body>
  <h1>Play Minecraft</h1>
  <div id="game-wrap">
    <iframe id="game" src="eagler.html" title="EaglercraftX" tabindex="0"
      allow="fullscreen; autoplay; gamepad; pointer-lock; clipboard-write"
      allowfullscreen></iframe>
  </div>
  <button id="fs">Fullscreen</button>

  <script>
    var game = document.getElementById('game');
    function focusGame() { try { game.focus(); game.contentWindow.focus(); } catch (e) {} }
    game.addEventListener('load', focusGame);
    document.getElementById('game-wrap').addEventListener('mousedown', focusGame);
    document.getElementById('fs').addEventListener('click', function () {
      (game.requestFullscreen || game.webkitRequestFullscreen).call(game);
      setTimeout(focusGame, 300);
    });
    document.addEventListener('fullscreenchange', function () { setTimeout(focusGame, 200); });
  </script>
</body>
</html>
